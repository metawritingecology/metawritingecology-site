<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Public Surface Case — 2026-09-19</title>
  <meta name="description" content="A dated follow-up to the 2026-08-18 public surface case. The platform-field layer that specimen declined to verify has since been performed and institutionally reported. This page adds the later layers, records how fast cohesion formed and how the dispute's template was translated into an existing performance repertoire, and keeps every layer apart. The earlier specimen is preserved unchanged. External public-discourse observation, not repository evidence." />
  <style>
    :root { --deep:#15130f; --raised:#24211c; --max:920px; }
    *{box-sizing:border-box}
    html{background:var(--bg);scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--text);font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:17px;line-height:1.7}
    a{color:var(--link);text-decoration-thickness:1px;text-underline-offset:3px}
    a:hover{color:var(--link-hover)}
    a:focus-visible,summary:focus-visible{outline:2px solid var(--link);outline-offset:4px;border-radius:2px}
    h1,h2,h3{margin:0;color:var(--text);font-weight:600;line-height:1.22}
    p{margin:0}
    code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--accent);background:transparent;padding:0}
    main{max-width:var(--max);margin:0 auto;padding:72px 24px 96px}
    .kicker,.label{font-size:.75rem;letter-spacing:.085em;text-transform:uppercase}
    .kicker{color:var(--link);margin-bottom:14px}
    .label{color:var(--muted)}

    .case-head{max-width:760px;padding-bottom:42px;border-bottom:1px solid var(--line)}
    .case-head h1{font-size:clamp(2rem,5vw,3.45rem);letter-spacing:-.04em;max-width:18ch;color:var(--accent)}
    .subtitle{margin-top:16px;max-width:44rem;color:var(--muted);font-size:1.05rem}
    .framing{margin-top:20px;max-width:42rem;font-size:1.04rem}
    .date-row{display:flex;gap:30px;flex-wrap:wrap;margin-top:26px;color:var(--muted);font-size:.88rem}
    .date-row span{display:block;margin-bottom:2px;color:var(--muted);font-size:.72rem;letter-spacing:.07em;text-transform:uppercase}
    .genre{margin-top:18px;padding:12px 0;border-top:1px dashed var(--line);border-bottom:1px dashed var(--line);color:var(--muted);font-size:.86rem;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
    .genre b{color:var(--text);font-weight:500}

    .flow{margin:26px 0 0;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.82rem;line-height:1.7;white-space:pre-wrap}

    .movement{scroll-margin-top:20px;padding:52px 0 8px;border-top:1px solid var(--line)}
    .movement:first-of-type{border-top:0}
    .m-num{color:var(--link);font-size:.78rem;font-weight:650;letter-spacing:.08em;text-transform:uppercase}
    .movement h2{margin-top:10px;max-width:34ch;font-size:clamp(1.4rem,3vw,2rem);letter-spacing:-.02em}
    .movement p.lead{margin-top:14px;max-width:46rem}
    .movement p.note{margin-top:14px;max-width:46rem;color:var(--muted);font-size:.95rem}
    .candidate{margin-top:8px;color:var(--muted);font-size:.78rem;letter-spacing:.02em}
    .candidate code{color:var(--accent)}

    .reading{margin-top:22px}
    .reading-row{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:14px 0;border-top:1px solid var(--line)}
    .reading-row:last-child{border-bottom:1px solid var(--line)}
    .reading-row dt{color:var(--muted);font-size:.72rem;letter-spacing:.07em;text-transform:uppercase}
    .reading-row dd{margin:0;max-width:46rem}
    .reading-row.reading-interpretation dd{color:var(--text)}
    .reading-row.reading-interpretation dt{color:var(--link)}
    .reading-row.reading-limit dd{color:var(--muted);font-size:.91rem}

    .distinctions{margin:18px 0 0;padding:14px 0;border-top:1px dashed var(--line);border-bottom:1px dashed var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:var(--muted);font-size:.82rem;line-height:1.85;white-space:pre-wrap}

    .gloss{margin-top:16px;padding-left:16px;border-left:1px solid var(--line);color:var(--muted);font-size:.9rem}
    .gloss p+p{margin-top:8px}

    .not-list{margin:14px 0 0;color:var(--muted);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.82rem;line-height:1.8;white-space:pre-wrap}

    .trajectory{margin-top:22px}
    .step{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:14px 0;border-top:1px solid var(--line)}
    .step:last-child{border-bottom:1px solid var(--line)}
    .step dt{color:var(--accent);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:.82rem;font-variant-numeric:tabular-nums}
    .step dt span{display:block;margin-top:4px;color:var(--muted);font-family:ui-sans-serif,system-ui,sans-serif;font-size:.72rem;letter-spacing:.07em;text-transform:uppercase}
    .step dd{margin:0;max-width:46rem;color:var(--muted);font-size:.93rem}
    .step.step-institutional dd{color:var(--text)}

    .relations{margin-top:22px;display:grid;grid-template-columns:1fr 1fr;gap:24px}
    .relations h3{font-size:.9rem;color:var(--link)}
    .relations ul{margin:10px 0 0;padding-left:1.05rem;color:var(--muted);font-size:.92rem}
    .relations li{margin:5px 0}
    .rel-note{margin-top:16px;max-width:46rem;color:var(--muted);font-size:.82rem}

    details{margin-top:22px}
    summary{cursor:pointer;width:fit-content;color:var(--link);font-size:.85rem;font-weight:600}
    .reconstruction{margin-top:12px;padding-left:16px;border-left:1px solid var(--line);color:var(--muted);font-size:.85rem;overflow-wrap:anywhere}
    .reconstruction p+p{margin-top:8px}
    .reconstruction code{color:var(--accent)}

    .sources{margin-top:22px;border-top:1px solid var(--line)}
    .source{display:grid;grid-template-columns:120px 1fr;gap:16px;padding:12px 0;border-bottom:1px solid var(--line);font-size:.86rem}
