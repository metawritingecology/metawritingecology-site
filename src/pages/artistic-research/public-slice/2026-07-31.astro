---
import "../../../styles/global.css";

// Local typed constant for this one page, matching the shape used by
// 2026-07-25.astro. Deliberately not a content collection, data module, loader,
// or reusable component: it describes one authored slice.
//
//   observedFact  - what a committed file shows
//   phrase        - authored presentation language, approved for this slice
//   evidence      - where the fact can be checked, pinned to an immutable commit
//   boundary      - what the fact does not establish
//
// Where this slice differs from 2026-07-25: that page read a sequence of
// repository states, and its slice date was the day those states were observed.
// This page reads one measurement, and its slice date is the corpus cut-off.
// The figures were assembled later. The date is the boundary of what was
// counted, not the day the counting happened.
//
// The charts are pre-rendered inline SVG built from the two committed data
// files. There is no client script, no runtime fetch and no D3 layer: nothing
// on this page is computed at view time, so the drawing cannot drift from the
// files it pins.

type EvidencePath = {
  path: string;
  url: string;
};

type Evidence = {
  repository: string;
  sha: string;
  timestamp: string;
  paths: readonly EvidencePath[];
};

type Measurement = {
  observedFact: string;
  phrase: string;
  evidence: Evidence;
  boundary: string;
};

// Evidence URLs are written as complete literal strings. The link verifier
// resolves occurrences statically and fails closed on an interpolated URL, so
// no base constant is composed here.
const REPO = "metawritingecology/meta-writing-ecology";

// The commit that adds the two data files, in the source repository. They are
// committed there rather than beside this page because this repository's
// ALLOWED_GITHUB_REPOS contract permits public source links to that repository
// only, and human-governed-ai-workflows.astro states the same rule in published
// words: website-repository files are referred to by visible path, without a
// GitHub URL. That pull request must land before this one, or these pins name a
// commit that is not yet public.
const COMMIT = "fd30bc693e83c3d6f9a882b791d597f57403c716";
const COMMITTED_AT = "2026-08-06T12:33:00+08:00";

const MEASUREMENTS: readonly Measurement[] = [
  {
    observedFact:
      "monthly_development_rate.csv holds eleven monthly rows for 2025-09 to 2026-07. The words column sums to 1,680,982 across 1,660 documents.",
    phrase: "Eleven months of writing, counted once and deduplicated.",
    evidence: {
      repository: REPO,
      sha: COMMIT,
      timestamp: COMMITTED_AT,
      paths: [
        {
          path: "visualizations/mwe-development-rate/monthly_development_rate.csv",
          url: "https://github.com/metawritingecology/meta-writing-ecology/blob/fd30bc693e83c3d6f9a882b791d597f57403c716/visualizations/mwe-development-rate/monthly_development_rate.csv"
        }
      ]
    },
    boundary:
      "The file contains these counts at this commit. A word count is a count of artefacts. It does not measure quality, difficulty, or how much of the work was thinking rather than typing."
  },
  {
    observedFact:
      "The posts column sums to 192 and reads 0 for 2025-09. For 2026-07 the chart prints not in export rather than a number, because the Medium index it draws on was exported 2026-07-07.",
    phrase: "Two blanks sit in the published series, and only one of them is a zero.",
    evidence: {
      repository: REPO,
      sha: COMMIT,
      timestamp: COMMITTED_AT,
      paths: [
        {
          path: "visualizations/mwe-development-rate/monthly_development_rate.csv",
          url: "https://github.com/metawritingecology/meta-writing-ecology/blob/fd30bc693e83c3d6f9a882b791d597f57403c716/visualizations/mwe-development-rate/monthly_development_rate.csv"
        }
      ]
    },
    boundary:
      "An export boundary is not a measurement. Nothing here establishes what was or was not published after 2026-07-07."
  },
  {
    observedFact:
      "Indexed to 2025-10, the written series stays above its base from 2026-03 onward and reaches 2,332.8 in 2026-06. The published series falls from the same base to a single post in 2026-06.",
    phrase: "The two lines leave the same month and go opposite ways.",
    evidence: {
      repository: REPO,
      sha: COMMIT,
      timestamp: COMMITTED_AT,
      paths: [
        {
          path: "visualizations/mwe-development-rate/monthly_development_rate.csv",
          url: "https://github.com/metawritingecology/meta-writing-ecology/blob/fd30bc693e83c3d6f9a882b791d597f57403c716/visualizations/mwe-development-rate/monthly_development_rate.csv"
        }
      ]
    },
    boundary:
      "Each series is indexed to its own base, so the vertical distance between them is divergence in relative change and not a difference in output. Words and posts are not comparable in their own units, and where the lines cross depends on the base month chosen."
  },
  {
    observedFact:
      "The token columns are empty for the first eight months. The first figure is 2026-05, and the three recorded months sum to 1,815,940,311.",
    phrase: "The machine record begins two months after the writing turns.",
    evidence: {
      repository: REPO,
      sha: COMMIT,
      timestamp: COMMITTED_AT,
      paths: [
        {
          path: "visualizations/mwe-development-rate/monthly_development_rate.csv",
          url: "https://github.com/metawritingecology/meta-writing-ecology/blob/fd30bc693e83c3d6f9a882b791d597f57403c716/visualizations/mwe-development-rate/monthly_development_rate.csv"
        }
      ]
    },
    boundary:
      "An empty month is an absence in the log, not a measured zero. That the writing turn precedes the first logged token is a fact about ordering and not about cause, and a token count is evidence about tool use rather than about effort or output."
  },
  {
    observedFact:
      "summary.json records 835 documents dated by a week tag in their own front matter and 830 dated by a modification time. No document dated 2026-07 or later carries a tag.",
    phrase: "The most recent months rest on the weaker of the two dating sources.",
    evidence: {
      repository: REPO,
      sha: COMMIT,
      timestamp: COMMITTED_AT,
      paths: [
        {
          path: "visualizations/mwe-development-rate/summary.json",
          url: "https://github.com/metawritingecology/meta-writing-ecology/blob/fd30bc693e83c3d6f9a882b791d597f57403c716/visualizations/mwe-development-rate/summary.json"
        }
      ]
    },
    boundary:
      "A modification time records when a file was last organised, not when it was written. The right-hand end of the written series should be read with less confidence than the left, and this page does not repair that."
  }
];
