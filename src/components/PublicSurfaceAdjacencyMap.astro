---
// Expanded Public Surface Adjacency Map — server-rendered component.
//
// Renders a review-first, boundary-preserving interface around the ONE bundled
// adopted dataset. All interactivity is progressive enhancement layered on top
// of a complete no-JavaScript fallback: every one of the 59 records, every
// boundary statement, the legend, the counts, and the snapshot identity all
// render without scripts and are never hidden behind a JavaScript-only control.
//
// Validation runs at BUILD time on the RAW bundled bytes (imported as text via
// Vite `?raw`, so no runtime fetch and no filesystem path is exposed):
// byte length -> SHA-256 -> Git blob id -> fatal UTF-8 decode -> JSON parse ->
// full dataset contract. The route is prerendered, so a violation fails the
// build rather than rendering unverified or partially valid data.
//
// This component is independent of the frozen 30-record authority-map product
// and imports nothing from it.
//
// P7.1 authors the SVG skeleton statically rather than building it at runtime.
// That is what makes layer identity, layer order and — critically — the order
// of the 59 record controls observable to a source contract and to the build
// verifier. Sequential Tab order follows authored DOM order, and sequential Tab
// order is the COMPLETE keyboard-reachability surface, so it cannot be left to
// a runtime append loop. The client binds to these elements by key and never
// creates, replaces, removes or reorders one.

import rawSnapshotText from "../data/public-surface-adjacency-map/last-known-good.json?raw";
import {
  assertSnapshotFromRawText,
  SOURCE_REPOSITORY,
  SOURCE_MERGE_COMMIT,
  SNAPSHOT_SOURCE_COMMIT,
  SNAPSHOT_SOURCE_PATH,
  SNAPSHOT_COMMIT_URL,
  SNAPSHOT_SHA256,
  SNAPSHOT_GIT_BLOB_SHA,
  SNAPSHOT_BYTE_LENGTH,
  FALLBACK_STATUS_LABEL,
} from "../lib/public-surface-adjacency-map/fallback.ts";
import {
  EXPECTED_EDGE_COUNTS,
  EXPECTED_TOTAL_EDGES,
  FIXED_BAND_ROLES,
  fixedBandRecords,
  isApprovedSourceUrl,
  semanticLayoutRecords,
} from "../lib/public-surface-adjacency-map/contract.ts";
import {
  compareNodes,
  computeRadialLayout,
  computeRoleOrbit,
  formatLogicalNumber,
  GRAPH_RECORD_ORDER,
  groupArcPath,
  CENTRE_X,
  CENTRE_Y,
  ROLE_LABEL_R,
  SEPARATOR_RING_R,
  VIEWBOX,
  type LayoutPoint,
} from "../lib/public-surface-adjacency-map/layout.ts";
import { DECOR_MARKS } from "../lib/public-surface-adjacency-map/decor.ts";

const snapshot = await assertSnapshotFromRawText(rawSnapshotText);

// Approved public wording comes from ONE shared module so the page metadata,
// this component, the tests, and the build verifier pin identical strings.
import {
  APPROVED_TITLE,
  APPROVED_DESCRIPTION,
  RELATIONSHIP_SENTENCE,
  AUTHORITY_VIEW_LABEL,
  EXPANDED_VIEW_LABEL,
  AUTHORITY_ROUTE,
  PARENT_ROUTE,
  NOT_CLAIMS,
  SCOPE_STATEMENT,
  ABOUT_SUMMARY,
  CENTRAL_STATEMENT_LINES,
  GRAPH_REGION_LABEL,
  GROUP_ARC_STATEMENT,
  NAVIGATION_TOGGLE_LABEL,
  RECORD_ORDER_DISCLAIMER,
  ROLE_ORBIT_CAPTION,
  ROLE_ORBIT_LABELS,
  SEPARATOR_CAPTION,
  SOURCE_NAMED_TOGGLE_LABEL,
} from "../lib/public-surface-adjacency-map/publicWording.ts";

// --- Deterministic display order --------------------------------------------

const conceptRecords = [...semanticLayoutRecords(snapshot)].sort(compareNodes);
const bandRecords = fixedBandRecords(snapshot);
const allRecords = [...snapshot.nodes].sort(compareNodes);

const roleCounts = FIXED_BAND_ROLES.map((role) => ({
  role,
  records: bandRecords.filter((node) => node.visualization_role === role).sort(compareNodes),
}));

const groupingKeys = [...new Set(conceptRecords.map((node) => node.grouping))].sort();

// --- Authored radial geometry ------------------------------------------------
//
// Computed once at build time from the validated records alone. No edge takes
// part in any coordinate here.

const radial = computeRadialLayout(snapshot.nodes);
const orbit = computeRoleOrbit(snapshot.nodes);

/** The complete authored control order. Sequential Tab order follows it. */
const graphRecordOrder = GRAPH_RECORD_ORDER(snapshot.nodes);

const pointOf = new Map([...radial.positions, ...orbit.positions]);

/**
 * The authored coordinate for one record.
 *
 * Every record in `GRAPH_RECORD_ORDER` belongs to exactly one of the two
 * coordinate spaces, so a miss is impossible by construction. It throws rather
 * than falling back, because this route is prerendered: a record without a
 * coordinate must fail the build, never render a control at an invented
 * position.
 */
const pointFor = (id: string): LayoutPoint => {
  const point = pointOf.get(id);
  if (!point) throw new Error(`no authored coordinate for record ${id}`);
  return point;
};

const fmt = formatLogicalNumber;

/**
 * Compact-width role-label radius — PRESENTATION ONLY.
 *
 * The logical viewBox is fixed, so the rendered size of a label is its logical
 * font size times the SVG's on-screen scale. At 390px that scale is about 0.32,
 * which renders the 13-unit desktop label at roughly 4 CSS pixels. The fix is a
 * much larger logical font at compact widths — but a 36-unit label cannot fit
 * the 31-unit annulus between the separator ring at 385 and the role halo at
 * 416, and would cross the ring.
 *
 * So at compact widths the label moves OUTWARD, past the role orbit, into the
 * empty margin, where a large label has room and still sits on its own radius —
 * label outside, glyph inside, same angle, so the association stays unambiguous.
 *
 * Nothing here changes geometry. `ROLE_LABEL_R`, `ROLE_ORBIT_R`, the role
 * order, the record order, the glyph footprint, the concept coordinates, the
 * grouping arcs and the separator ring are all untouched, and the coordinates
 * `computeRoleOrbit` publishes are rendered unchanged into `x` and `y`. This is
 * a CSS transform applied only below the wide breakpoint.
 */
const COMPACT_ROLE_LABEL_R = 486;
const COMPACT_LABEL_SHIFT = COMPACT_ROLE_LABEL_R / ROLE_LABEL_R - 1;

/** The outward shift for one label, as a fraction of its own radius vector. */
const compactLabelShift = (point: { x: number; y: number }) =>
  `--psadj-label-shift-x:${fmt((point.x - CENTRE_X) * COMPACT_LABEL_SHIFT)}px;` +
  `--psadj-label-shift-y:${fmt((point.y - CENTRE_Y) * COMPACT_LABEL_SHIFT)}px;`;

/**
 * Readable tangential orientation for a label sitting ON the grouping arc.
 * Text follows the arc, so its RADIAL extent stays inside the 14/15 unit gap
 * between the concept hit area and the separator ring. The flip keeps a label
 * in the lower half from rendering upside down.
 */
const arcLabelTransform = (x: number, y: number, midAngle: number) => {
  const normalised = ((midAngle % 360) + 360) % 360;
  const flip = normalised > 0 && normalised < 180;
  const rotation = midAngle + 90 + (flip ? 180 : 0);
  return `translate(${fmt(x)} ${fmt(y)}) rotate(${fmt(rotation)})`;
};

// Embed the validated dataset for the client with no runtime request. Escape
// "<" so the JSON can never break out of the script element.
const dataJson = JSON.stringify(snapshot).replace(/</g, "\\u003c");

// Rendered link safety: only an approved HTTPS source-repository URL is ever
// emitted as an href, and every string is rendered as text (Astro escapes all
// interpolated expressions — no field is ever injected as raw HTML).
const safeHref = (node: { canonical_public_url: string; repository_path: string }) =>
  isApprovedSourceUrl(node.canonical_public_url, node.repository_path)
    ? node.canonical_public_url
    : undefined;
---

<section class="psadj" data-psadj aria-labelledby="psadj-title">
  <header class="psadj__header">
    <h1 id="psadj-title">{APPROVED_TITLE}</h1>
    <p class="psadj__subtitle">{APPROVED_DESCRIPTION}</p>
    <p class="psadj__scope-lead" data-psadj-scope>{SCOPE_STATEMENT}</p>
  </header>

  <!-- Persistent scope and boundary banner. Never sourced from the runtime
       manifest or a runtime snapshot, so a runtime activation can never replace
       or remove a boundary statement. Never collapsed. -->
  <div class="psadj__scope" role="note" aria-label="Scope and boundary statements">
    <h2 class="psadj__scope-title">Scope and boundaries</h2>
    <ul class="psadj__scope-list" data-psadj-boundary-statements>
      {snapshot.boundary_statements.map((statement) => <li>{statement}</li>)}
    </ul>
    <p class="psadj__scope-note">This view is:</p>
    <ul class="psadj__scope-list psadj__scope-list--not">
      {NOT_CLAIMS.map((claim) => <li>{claim}</li>)}
    </ul>
  </div>

  <!-- GRAPH REGION — graph-first, above the fold.

       Without JavaScript the canvas, the toolbar, the details panel and the
       readout all stay hidden and the complete record list below carries the
       whole product. The compact legend stays visible either way, so the
       grouping-arc statement is present in the no-JS fallback. -->
  <section class="psadj__panel psadj__view" aria-label="Adjacency view">
    <h2>Adjacency view</h2>

    <div class="psadj__controls" data-psadj-controls hidden>
      <fieldset class="psadj__fieldset">
        <legend>Edge classes shown</legend>
        <label class="psadj__control">
          <input
            type="checkbox"
            checked
            data-psadj-toggle="source_named_adjacency"
          />
          <span>{SOURCE_NAMED_TOGGLE_LABEL}</span>
        </label>
        <label class="psadj__control">
          <input
            type="checkbox"
            data-psadj-toggle="navigation_adjacency"
          />
          <span>{NAVIGATION_TOGGLE_LABEL}</span>
        </label>
      </fieldset>
      <p class="psadj__controls-note">
        Showing or hiding an edge class reveals or hides already-defined edges only.
        It never moves a record, changes a record size, or changes any ordering.
      </p>
    </div>

    <div class="psadj__grid">
      <div class="psadj__canvas-column">
        <div class="psadj__canvas" data-psadj-canvas hidden>
          <svg
            viewBox={VIEWBOX}
            preserveAspectRatio="xMidYMid meet"
            role="group"
            aria-label={GRAPH_REGION_LABEL}
          >
            <title>
              Expanded public surface adjacency graph: {radial.concepts.length} concept
              records on one ring of equal radius and {orbit.roles.length} context records
              on a separate outer orbit.
            </title>
            <desc>
              Every concept record sits at the same radius and the same angular pitch, so
              no position indicates importance, authority or centrality. Directed edges are
              drawn between concept records only. Source-declared adjacency uses a solid
              line with a filled arrow head; provisional navigation adjacency uses a dashed
              line with an open arrow head. Grouping arcs are navigation labels and create
              no enclosure. Every record is also listed in full below this graph.
            </desc>

            <defs>
              <marker
                id="psadj-arrow-filled"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker>
              <marker
                id="psadj-arrow-open"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10" fill="none" stroke-width="1.4" /></marker>
            </defs>

            <!-- Layer 1 — decor. OUTSIDE the viewport wrapper, so it never pans,
                 zooms or creates moving parallax. Dataset-independent, removable
                 without information loss. -->
            <g data-psadj-layer="decor" aria-hidden="true">
              {DECOR_MARKS.map((mark) => (
                <circle
                  class="psadj-decor"
                  cx={fmt(mark.x)}
                  cy={fmt(mark.y)}
                  r={fmt(mark.r)}
                  opacity={mark.opacity}
                />
              ))}
            </g>

            <!-- The viewport wrapper is a transform container, not a rendering
                 layer. P7.1 writes no transform onto it. -->
            <g data-psadj-viewport>
              <!-- Layer 2 — edges. Populated by keyed join; a render filter only. -->
              <g data-psadj-layer="edges"></g>

              <!-- Layer 3 — grouping arcs. Rendered, NON-INTERACTIVE in P7.1:
                   no listener, no tabindex, no control role, no placeholder. -->
              <g data-psadj-layer="arcs">
                <circle
                  class="psadj-separator"
                  cx="500"
                  cy="500"
                  r={fmt(SEPARATOR_RING_R)}
                  aria-hidden="true"
                />
                {radial.groups.map((group) => (
                  <path
                    class="psadj-arc"
                    data-psadj-arc={group.key}
                    d={groupArcPath(group)}
                    aria-hidden="true"
                  />
                ))}
                {radial.groups.map((group) => (
                  <text
                    class="psadj-arc-label"
                    data-psadj-arc-label={group.key}
                    text-anchor="middle"
                    transform={arcLabelTransform(
                      500 + 370 * Math.cos((group.midAngle * Math.PI) / 180),
                      500 + 370 * Math.sin((group.midAngle * Math.PI) / 180),
                      group.midAngle,
                    )}>{group.key}</text>
                ))}
                {orbit.labels.map((label) => (
                  <text
                    class="psadj-role-label"
                    data-psadj-role-label={label.role}
                    text-anchor="middle"
                    x={fmt(label.x)}
                    y={fmt(label.y)}
                    style={compactLabelShift(label)}>{ROLE_ORBIT_LABELS[label.role] ?? label.role}</text>
                ))}
              </g>

              <!-- Layer 4 — centre. Path-free, two approved lines, nothing else. -->
              <g data-psadj-layer="centre" aria-hidden="true">
                {CENTRAL_STATEMENT_LINES.map((line, index) => (
                  <text
                    class="psadj-centre-line"
                    x="500"
                    y={fmt(500 + (index - 0.5) * 19)}
                    text-anchor="middle">{line}</text>
                ))}
              </g>

              <!-- Layer 5 — nodes. All 59 record controls, authored in
                   GRAPH_RECORD_ORDER. Sequential Tab order follows this order,
                   and it is the complete keyboard-reachability surface, so the
                   client binds by key and never reorders them.

                   Every control carries a focusable tabindex. A roving-tabindex
                   design that leaves only one record in the sequential focus
                   order is prohibited. -->
              <g data-psadj-layer="nodes">
                {graphRecordOrder.map((node) => {
                  const point = pointFor(node.id);
                  const role = node.visualization_role;
                  return (
                    <g
                      class={`psadj-node psadj-node--${role}`}
                      data-psadj-node={node.id}
                      data-psadj-role={role}
                      data-psadj-group={node.grouping}
                      data-selected="false"
                      tabindex="0"
                      role="button"
                      aria-pressed="false"
                      aria-label={`${node.display_label}. ${role} record.`}
                      transform={`translate(${fmt(point.cx)} ${fmt(point.cy)})`}>
                      <circle class="psadj-node__halo" r="14" />
                      {role === "concept" && <circle class="psadj-node__glyph" r="9" />}
                      {role === "orientation" && (
                        <polygon class="psadj-node__glyph" points="0,-9 9,0 0,9 -9,0" />
                      )}
                      {role === "boundary" && (
                        <g class="psadj-node__glyph">
                          <rect x="-9" y="-9" width="18" height="18" rx="2" />
                          <rect x="-6" y="-6" width="12" height="12" rx="1" />
                        </g>
                      )}
                      {role === "anchor" && (
                        <polygon
                          class="psadj-node__glyph"
                          points="9,0 4.5,7.794 -4.5,7.794 -9,0 -4.5,-7.794 4.5,-7.794"
                        />
                      )}
                      <circle class="psadj-node__hit" r="26" />
                    </g>
                  );
                })}
              </g>
            </g>
          </svg>
        </div>

        <!-- Visual label readout. Immediately after the SVG, inside the graph
             region, before the compact legend, OUTSIDE the SVG and outside the
             viewport wrapper.

             It is a duplicate visual aid and never an accessibility surface:
             aria-hidden, no role, no aria-live, no aria-atomic, no tabindex. It
             is written with textContent only. The authoritative assistive
             surfaces remain each node's accessible name, the details panel, the
             complete 59-record list and the status live region. -->
        <p data-psadj-label-readout aria-hidden="true"></p>
      </div>

      <div class="psadj__details" data-psadj-details hidden>
        <h3 data-psadj-details-title>No record selected</h3>
        <dl class="psadj__status-list" data-psadj-details-body></dl>
      </div>
    </div>

    <!-- Compact legend. Stays visible without JavaScript, so the approved
         grouping-arc statement is present in the fallback. -->
    <div class="psadj__compact-legend">
      <p class="psadj__arc-statement" data-psadj-arc-statement>{GROUP_ARC_STATEMENT}</p>
      <p class="psadj__orbit-caption" data-psadj-orbit-caption>{ROLE_ORBIT_CAPTION}</p>
      <p class="psadj__separator-caption">{SEPARATOR_CAPTION}</p>
      <p class="psadj__order-disclaimer" data-psadj-order-disclaimer>{RECORD_ORDER_DISCLAIMER}</p>
    </div>

    <p class="psadj__noscript" data-psadj-noscript>
      The interactive view is progressive enhancement. The complete record list
      below is server rendered and stays available without JavaScript.
    </p>
  </section>

  <!-- Live status region. Announces runtime status, selection changes, and
       edge-class toggle state. Authoritative for assistive output. -->
  <p class="psadj__live" role="status" aria-live="polite" data-psadj-live>
    {FALLBACK_STATUS_LABEL}. Source-declared adjacency shown. Provisional
    navigation adjacency hidden.
  </p>

  <!-- Relationship to the other public view. Never collapsed. -->
  <section class="psadj__panel psadj__relationship" aria-label="Relationship to the other public view">
    <h2>Two parallel public views</h2>
    <p data-psadj-relationship>{RELATIONSHIP_SENTENCE}</p>
    <ul class="psadj__view-list">
      <li>
        <a href={AUTHORITY_ROUTE}>{AUTHORITY_VIEW_LABEL}</a>
      </li>
      <li>
        <span aria-current="page">{EXPANDED_VIEW_LABEL} (this page)</span>
      </li>
    </ul>
    <p>
      <a href={PARENT_ROUTE}>Return to the Public Surface Map</a>
    </p>
  </section>

  <!-- Data status. Never collapsed. -->
  <p class="psadj__data-status">
    Data status: <span data-psadj-runtime-status>{FALLBACK_STATUS_LABEL}</span>
  </p>

  <!-- Collapsed about-region. Provenance is RELOCATED, never removed: the
       content below renders server-side and is present in the emitted HTML
       whether or not the disclosure is open. -->
  <details class="psadj__about">
    <summary>{ABOUT_SUMMARY}</summary>

    <section class="psadj__panel psadj__status" aria-label="Snapshot status">
      <h2>Snapshot status</h2>
      <dl class="psadj__status-list">
        <div class="psadj__status-row">
          <dt>Source repository</dt>
          <dd><code>{SOURCE_REPOSITORY}</code></dd>
        </div>
        <div class="psadj__status-row">
          <dt>Source path</dt>
          <dd><code>{SNAPSHOT_SOURCE_PATH}</code></dd>
        </div>
        <div class="psadj__status-row">
          <dt>Source commit</dt>
          <dd>
            <a
              href={SNAPSHOT_COMMIT_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="psadj__commit-link"><code data-psadj-source-commit>{SNAPSHOT_SOURCE_COMMIT}</code></a>
          </dd>
        </div>
        <div class="psadj__status-row">
          <dt>Adopted from merge commit</dt>
          <dd><code>{SOURCE_MERGE_COMMIT}</code></dd>
        </div>
        <div class="psadj__status-row">
          <dt>SHA-256</dt>
          <dd>
            <code
              class="psadj__hash"
              tabindex="0"
              aria-label={`Snapshot SHA-256 ${SNAPSHOT_SHA256}`}
              data-psadj-sha256>{SNAPSHOT_SHA256}</code>
          </dd>
        </div>
        <div class="psadj__status-row">
          <dt>Git blob</dt>
          <dd><code data-psadj-git-blob>{SNAPSHOT_GIT_BLOB_SHA}</code></dd>
        </div>
        <div class="psadj__status-row">
          <dt>Byte length</dt>
          <dd><code>{SNAPSHOT_BYTE_LENGTH}</code></dd>
        </div>
        <div class="psadj__status-row">
          <dt>Schema version</dt>
          <dd>{snapshot.schema_version}</dd>
        </div>
      </dl>
    </section>

    <section class="psadj__panel psadj__counts" aria-label="Record and edge counts">
      <h2>Counts</h2>
      <dl class="psadj__status-list">
        <div class="psadj__status-row">
          <dt>Records</dt>
          <dd data-psadj-record-count>{snapshot.nodes.length}</dd>
        </div>
        <div class="psadj__status-row">
          <dt>Concept records in the semantic layout</dt>
          <dd data-psadj-semantic-count>{conceptRecords.length}</dd>
        </div>
        <div class="psadj__status-row">
          <dt>Records in fixed bands</dt>
          <dd data-psadj-band-count>{bandRecords.length}</dd>
        </div>
        <div class="psadj__status-row">
          <dt>Edges</dt>
          <dd data-psadj-edge-count>{EXPECTED_TOTAL_EDGES}</dd>
        </div>
        <div class="psadj__status-row">
          <dt>Source-declared adjacency edges</dt>
          <dd data-psadj-source-named-count>{EXPECTED_EDGE_COUNTS.source_named_adjacency}</dd>
        </div>
        <div class="psadj__status-row">
          <dt>Provisional navigation adjacency edges</dt>
          <dd data-psadj-navigation-count>{EXPECTED_EDGE_COUNTS.navigation_adjacency}</dd>
        </div>
      </dl>
    </section>

    <!-- Extended edge-class legend. Each class is distinguished by a written
         label, a line pattern, and a shape marker — never by color alone. -->
    <section class="psadj__panel psadj__legend" aria-label="Edge class legend">
      <h2>Edge classes</h2>
      <ul class="psadj__legend-list">
        {snapshot.edge_classes.map((descriptor) => (
          <li class={`psadj__legend-item psadj__legend-item--${descriptor.edge_class}`}>
            <span class="psadj__legend-swatch" aria-hidden="true">
              {descriptor.edge_class === "source_named_adjacency" ? "──▸" : "╌╌▹"}
            </span>
            <span class="psadj__legend-body">
              <strong>{descriptor.display_label}</strong>
              <span class="psadj__legend-pattern">
                {descriptor.edge_class === "source_named_adjacency"
                  ? "solid line, filled arrow head"
                  : "dashed line, open arrow head"}
              </span>
              <span class="psadj__legend-detail">Evidence: {descriptor.evidence_source}</span>
              <span class="psadj__legend-detail">
                Shown by default: {descriptor.default_visible ? "yes" : "no"}
              </span>
            </span>
          </li>
        ))}
      </ul>
      <p class="psadj__legend-note">
        Both classes are directed and both carry a navigation-only authority ceiling.
        Governance references, source-use references, visual layout adjacency, and
        user-confirmed relations are never rendered here.
      </p>
      <p class="psadj__legend-note">{GROUP_ARC_STATEMENT}</p>
    </section>

    <!-- Fixed-band summary: the 10 non-concept records, listed by role, outside
         the semantic layout. -->
    <section class="psadj__panel psadj__bands" aria-label="Fixed bands">
      <h2>Fixed bands</h2>
      <p>
        These {bandRecords.length} records render in fixed, visibly separate bands.
        They do not enter the semantic layout, are never semantic-edge endpoints,
        and contribute nothing to edge layout.
      </p>
      <p>{ROLE_ORBIT_CAPTION}</p>
      {roleCounts.map((band) => (
        <div class="psadj__band">
          <h3>{band.role} ({band.records.length})</h3>
          <ul>
            {band.records.map((node) => <li>{node.display_label}</li>)}
          </ul>
        </div>
      ))}
    </section>

    <!-- Grouping summary for the semantic layout. -->
    <section class="psadj__panel psadj__groupings" aria-label="Semantic layout groupings">
      <h2>Semantic layout groupings</h2>
      <p>
        Only the {conceptRecords.length} concept records enter the semantic layout.
        Grouping comes from the MODEL_ATLAS field recorded for each record and is a
        navigation grouping only.
      </p>
      <ul>
        {groupingKeys.map((key) => (
          <li>
            {key} ({conceptRecords.filter((node) => node.grouping === key).length})
          </li>
        ))}
      </ul>
    </section>
  </details>

  <!-- Complete no-JavaScript fallback: every one of the 59 records. -->
  <section class="psadj__panel psadj__records" aria-labelledby="psadj-records-title">
    <h2 id="psadj-records-title">All {snapshot.nodes.length} records</h2>
    <p class="psadj__records-note">
      Record order is alphabetical by display label. Order does not indicate
      hierarchy, priority, or importance.
    </p>
    <ol class="psadj__record-list" data-psadj-record-list>
      {allRecords.map((node) => (
        <li class="psadj__record" data-psadj-record={node.id}>
          <span class="psadj__record-label">{node.display_label}</span>
          <dl class="psadj__record-fields">
            <div class="psadj__record-field">
              <dt>Visualization role</dt>
              <dd>{node.visualization_role}</dd>
            </div>
            <div class="psadj__record-field">
              <dt>Grouping</dt>
              <dd>{node.grouping}</dd>
            </div>
            <div class="psadj__record-field">
              <dt>Relation evidence ceiling</dt>
              <dd>{node.relation_evidence_ceiling}</dd>
            </div>
            <div class="psadj__record-field">
              <dt>Canonical source</dt>
              <dd>
                {safeHref(node) ? (
                  <a href={safeHref(node)} target="_blank" rel="noopener noreferrer">
                    {node.repository_path}
                  </a>
                ) : (
                  <code>{node.repository_path}</code>
                )}
              </dd>
            </div>
          </dl>
        </li>
      ))}
    </ol>
  </section>

  <script type="application/json" data-psadj-data set:html={dataJson}></script>
</section>

