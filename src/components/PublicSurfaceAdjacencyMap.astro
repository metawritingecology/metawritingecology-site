<style is:global>
  /* Rendered graph styling — Dark Archival Observatory.
     Global because the edge layer is populated by the client module and
     therefore carries no scoped-style attribute. Every selector is namespaced
     under .psadj__canvas so no other route is affected. */
  /* Dark Archival Observatory.
     A blue-black field, deliberately colder and darker than the surrounding
     site surface, so the graph reads as its own instrument rather than as more
     page. Every token is declared on `.psadj__canvas`, so nothing here reaches
     the global palette or any other route. */
  .psadj__canvas {
    /* Warm graphite field. It is lighter than the page surface (#11100d) so the
       graph reads as its own specimen plate rather than as more page, but its
       blue channel is BELOW its red channel, so it reads as neutral graphite
       rather than as a technology-blue dashboard. */
    --bg: #24211d;

    /* Record bodies are ONE neutral archival stone. Grouping never controls a
       record's visual mass — it appears only as the thin rim below. */
    --node-body: #b8b6aa;
    --node-outline: #cfccc0;
    --node-muted: #85877f;

    --muted: #a39e94;
    --centre-text: #e6e1d5;
    --line: #49453f;
    /* Deliberately sub-threshold. Decorative by construction. */
    --decor: #2b2823;

    /* Edges: two low-luminance graphite neutrals carried at low opacity, so the
       383 relations read as an ambient field rather than a bright central fog.
       Class distinction is carried by dash pattern and arrow head; these two
       tones are a secondary channel only. */
    --edge-source: #706d66;
    --edge-nav: #66645f;

    /* State channel. Three restrained mineral hues, none of them a group
       accent, so a state can never be mistaken for a grouping. */
    --focus: #e8d6a7;
    --hover: #b6a5b8;
    --selection: #8faea7;

    /* Seven equal-status mineral accents, deliberately NOT in hue-spectrum
       order and not mapped by quadrant. Going clockwise around the ring they
       run slate, sandstone, sage, iron rose, verdigris, plum, ochre — so the
       two warm-tan accents and the two green-grey accents are never adjacent
       and cannot read as one category. None is brighter or more saturated than
       the others: no group is visually "important". Grouping is also written
       out in the details panel and the record list, so colour is never the
       sole carrier of the distinction. */
    --group-ai-readable: #7a929d; /* steel slate   — ring position 1 */
    --group-boundary-representation: #b59a72; /* sandstone     — 2 */
    --group-coherence: #81917b; /* dry sage      — 3 */
    --group-constraint: #9b7e78; /* iron rose     — 4 */
    --group-proxy: #708a86; /* verdigris     — 5 */
    --group-responsibility: #957e89; /* dusty plum    — 6 */
    --group-semantic-field-foundations: #a88767; /* muted ochre   — 7 */
  }

  .psadj__canvas svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1;
    background: var(--bg);
  }

  /* Decor — behind everything, non-informational, never interactive. */
  .psadj__canvas [data-psadj-layer="decor"] {
    pointer-events: none;
  }

  .psadj__canvas .psadj-decor {
    fill: var(--decor);
  }

  /* Edges. Class distinction is carried by line pattern and arrow head, never
     by color alone. No filter, blur, glow or shadow in any state. */
  .psadj__canvas [data-psadj-layer="edges"] {
    pointer-events: none;
  }

  .psadj__canvas .psadj-edge {
    fill: none;
    opacity: 0.12;
  }

  .psadj__canvas .psadj-edge--source_named_adjacency {
    stroke: var(--edge-source);
    stroke-width: 0.9;
  }

  .psadj__canvas .psadj-edge--navigation_adjacency {
    stroke: var(--edge-nav);
    stroke-width: 0.8;
    stroke-dasharray: 5 4;
  }

  /* The selected neighbourhood lifts to a persistent, readable trace — never a
     glow. There is no separate hover/focus edge state in P7.1: edge emphasis is
     driven by SELECTION only, and wiring a hover-driven one would be a client
     change rather than a palette change. */
  .psadj__canvas .psadj-edge[data-emphasis="true"] {
    opacity: 0.58;
  }

  .psadj__canvas .psadj-edge[data-inactive="true"] {
    opacity: 0.05;
  }

  .psadj__canvas marker path {
    fill: var(--edge-source);
    stroke: var(--edge-nav);
  }

  /* Grouping arcs — rendered, non-interactive in P7.1. Arc length reflects the
     number of displayed records only; radius is fixed and carries nothing. */
  .psadj__canvas .psadj-arc {
    fill: none;
    stroke: var(--line);
    stroke-width: 2;
  }

  .psadj__canvas .psadj-separator {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }

  .psadj__canvas .psadj-arc-label,
  .psadj__canvas .psadj-role-label {
    fill: var(--muted);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .psadj__canvas .psadj-role-label {
    font-size: 13px;
  }

  /* Central region — path-free, two approved lines, never interactive. */
  .psadj__canvas [data-psadj-layer="centre"] {
    pointer-events: none;
  }

  .psadj__canvas .psadj-centre-line {
    fill: var(--centre-text);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.45;
  }

  /* Records. Equal 18 by 18 footprint for every role; no state changes size. */
  .psadj__canvas .psadj-node__glyph {
    fill: var(--node-body);
    stroke: var(--node-outline);
    stroke-width: 1.5;
  }

  .psadj__canvas .psadj-node__glyph rect {
    fill: var(--node-body);
    stroke: var(--node-outline);
    stroke-width: 1.5;
  }

  .psadj__canvas .psadj-node__hit {
    fill: transparent;
    stroke: none;
  }

  /* The ONLY place a grouping accent is painted: a thin rim on an otherwise
     neutral body. It never fills a record and never sets its size. */
  .psadj__canvas .psadj-node--concept .psadj-node__glyph {
    stroke: var(--group-stroke, var(--node-outline));
  }

  .psadj__canvas .psadj-node[data-psadj-group="Semantic Field Foundations"] {
    --group-stroke: var(--group-semantic-field-foundations);
  }
  .psadj__canvas .psadj-node[data-psadj-group="Boundary / Representation"] {
    --group-stroke: var(--group-boundary-representation);
  }
  .psadj__canvas .psadj-node[data-psadj-group="Coherence / Circulation / Collapse Risk"] {
    --group-stroke: var(--group-coherence);
  }
  .psadj__canvas .psadj-node[data-psadj-group="AI-Readable Interface / Externalization"] {
    --group-stroke: var(--group-ai-readable);
  }
  .psadj__canvas .psadj-node[data-psadj-group="Proxy / Legibility / Provenance"] {
    --group-stroke: var(--group-proxy);
  }
  .psadj__canvas .psadj-node[data-psadj-group="Responsibility / Benefit-Burden / Cost"] {
    --group-stroke: var(--group-responsibility);
  }
  .psadj__canvas .psadj-node[data-psadj-group="Constraint / Residue / Capability Shift"] {
    --group-stroke: var(--group-constraint);
  }

  /* Halo — a stroke ring in --accent, not a soft shadow. Constant by
     construction: the same radius, width and opacity for every record in every
     one of the three approved states. It never varies with any data value, and
     rest-state records carry no halo at all. */
  .psadj__canvas .psadj-node__halo {
    fill: none;
    stroke: var(--halo-color, var(--focus));
    stroke-width: 1.5;
    opacity: 0;
  }

  /* The three approved states each take their own hue, so focus, hover and
     selection are told apart by colour AND by the glyph treatments below —
     never by colour alone. Geometry is identical in all three: same radius,
     same stroke width, same opacity, never varying with any data value. */
  .psadj__canvas .psadj-node:hover .psadj-node__halo {
    --halo-color: var(--hover);
    opacity: 1;
  }

  .psadj__canvas .psadj-node:focus-visible .psadj-node__halo {
    --halo-color: var(--focus);
    opacity: 1;
  }

  .psadj__canvas .psadj-node[data-selected="true"] .psadj-node__halo {
    --halo-color: var(--selection);
    opacity: 1;
  }

  /* Kept as two separate rules rather than one selector list: the interaction
     suite's bounded focus model parses every branch of any rule mentioning
     :focus-visible and fails closed on syntax it does not support, so pairing a
     :hover branch with a :focus-visible branch would make a legitimate rule
     unevaluable. */
  .psadj__canvas .psadj-node:hover .psadj-node__glyph {
    stroke-width: 2.5;
  }

  .psadj__canvas .psadj-node:focus-visible .psadj-node__glyph {
    stroke-width: 2.5;
  }

  .psadj__canvas .psadj-node[data-selected="true"] .psadj-node__glyph {
    fill: var(--node-outline);
    stroke: var(--selection);
    stroke-width: 3;
  }

  .psadj__canvas .psadj-node[data-emphasis="true"] .psadj-node__glyph {
    stroke-width: 2;
  }

  /* Inactive records stay legible, focusable, selectable and announced. Raised
     from 0.28 with the darker field: the same fraction reads dimmer against
     blue-black than it did against the previous warm charcoal. */
  .psadj__canvas .psadj-node[data-inactive="true"] {
    opacity: 0.55;
  }

  .psadj__canvas .psadj-node[data-inactive="true"] .psadj-node__glyph {
    fill: var(--node-muted);
  }

  /* Responsive role labels — D18.
     ---------------------------------------------------------------------
     The viewBox is fixed, so a label's rendered size is its logical size
     times the SVG's on-screen scale. That scale falls to about 0.32 at 390px
     AND at 768px (where the two-column grid squeezes the canvas hardest), so
     the 13-unit desktop label renders at roughly 4 CSS pixels at both. These
     rules raise the logical size as the scale falls.

     Two regimes, because a large label does not fit the 31-unit annulus
     between the separator ring and the role halo:
       - down to 1200px the label stays in the annulus at ROLE_LABEL_R;
       - below 900px it moves outward past the orbit, where it has room.

     Placed in this global block, AFTER the scoped 640px rule, so the first
     `max-width` at-rule in this component remains the grid breakpoint.
     Geometry is untouched: this is font size and a CSS transform only. */
  @media (max-width: 1199px) {
    .psadj__canvas .psadj-role-label {
      font-size: 24px;
      transform: translate(var(--psadj-label-shift-x, 0), var(--psadj-label-shift-y, 0));
    }
  }

  @media (max-width: 899px) {
    .psadj__canvas .psadj-role-label {
      font-size: 38px;
    }
  }

  /* The visual label readout: never focusable, never a pointer target. */
  [data-psadj-label-readout] {
    margin: 0.5rem 0 0;
    min-height: 1.5em;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
    pointer-events: none;
  }
</style>

