{
  "name": "metawritingecology-site",
  "description": "Public surface website for Meta-Writing Ecology.",
  "cloudflare": {
    "label": "Meta-Writing Ecology Site",
    "products": [
      "Workers"
    ],
    "categories": [],
    "publish": true
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.12",
    "@astrojs/mdx": "4.3.13",
    "@astrojs/sitemap": "3.6.1",
    "astro": "5.18.2",
    "d3-selection": "3.0.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@types/d3-selection": "3.0.11",
    "fast-xml-parser": "5.9.3",
    "wrangler": "4.88.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "cf-typegen": "wrangler types",
    "check": "astro build && pnpm run check:astro && pnpm run check:ts && pnpm run test:metadata-contract && pnpm run test:metadata-verifier-lifecycle && wrangler deploy --dry-run && pnpm run test:contracts && pnpm run test:authority-layout && pnpm run test:authority-viewport && pnpm run test:authority-keyboard && pnpm run test:runtime && pnpm run test:retention && pnpm run test:orchestration && pnpm run test:workflow && pnpm run test:semantic-flow && pnpm run test:security-resilience && pnpm run test:indexing-discovery && pnpm run verify:public-surface-map && pnpm run verify:indexing-discovery-build && pnpm run verify:metadata-build && pnpm run test:adjacency-contract && pnpm run test:adjacency-runtime-manifest && pnpm run test:adjacency-runtime && pnpm run test:adjacency-interaction && pnpm run test:adjacency-endpoints && pnpm run test:adjacency-metadata && pnpm run test:adjacency-preservation && pnpm run test:adjacency-rendering-boundary && pnpm run test:adjacency-radial-layout && pnpm run test:adjacency-directional-navigation && pnpm run test:adjacency-visual-state && pnpm run verify:public-surface-adjacency-map",
    "check:astro": "astro check",
    "check:ts": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "preview": "astro build && wrangler dev",
    "test:adjacency-contract": "node --test tests/public-surface-adjacency-map/contract.test.ts",
    "test:adjacency-directional-navigation": "node --test tests/public-surface-adjacency-map/directionalNavigation.test.ts",
    "test:adjacency-endpoints": "node --test tests/public-surface-adjacency-map/endpointRouting.test.ts",
    "test:adjacency-interaction": "node --test tests/public-surface-adjacency-map/interaction.test.ts",
    "test:adjacency-metadata": "node --test tests/public-surface-adjacency-map/metadataIndexing.test.ts",
    "test:adjacency-preservation": "node --test tests/public-surface-adjacency-map/preservation.test.ts",
    "test:adjacency-radial-layout": "node --test tests/public-surface-adjacency-map/radialLayout.test.ts",
    "test:adjacency-rendering-boundary": "node --test tests/public-surface-adjacency-map/renderingBoundary.test.ts",
    "test:adjacency-runtime": "node --test tests/public-surface-adjacency-map/runtimeLoader.test.ts",
    "test:adjacency-visual-state": "node --test tests/public-surface-adjacency-map/visualState.test.ts",
    "test:adjacency-runtime-manifest": "node --test tests/public-surface-adjacency-map/runtimeManifest.test.ts",
    "test:authority-keyboard": "node --test tests/public-surface-authority-map/d3AuthorityKeyboardNavigation.test.ts",
    "test:authority-layout": "node --test tests/public-surface-authority-map/d3AuthorityLayout.test.ts",
    "test:authority-viewport": "node --test tests/public-surface-authority-map/d3AuthorityViewport.test.ts",
    "test:contracts": "node --test tests/public-surface-authority-map/contracts.test.ts",
    "test:indexing-discovery": "node --test tests/indexing-discovery.test.ts",
    "test:metadata-contract": "node --test tests/metadata-contract.test.ts",
    "test:metadata-verifier-lifecycle": "node --test tests/metadata-verifier-lifecycle.test.ts",
    "test:orchestration": "node --test tests/public-surface-authority-map/candidateOrchestration.test.ts",
    "test:retention": "node --test tests/public-surface-authority-map/snapshotRetention.test.ts",
    "test:runtime": "node --test tests/public-surface-authority-map/runtimeLoader.test.ts",
    "test:security-resilience": "node --test tests/security-resilience.test.ts",
    "test:semantic-flow": "node --test tests/semantic-flow-source-entries.test.ts",
    "test:workflow": "node --test tests/public-surface-authority-map/candidateWorkflow.test.ts",
    "verify:indexing-discovery-build": "node scripts/verify-indexing-discovery-build.mjs",
    "verify:metadata-build": "node scripts/verify-metadata-build.mjs",
    "verify:public-surface-adjacency-map": "node scripts/verify-public-surface-adjacency-map-build.mjs",
    "verify:public-surface-map": "node scripts/verify-public-surface-map-build.mjs"
  },
  "type": "module"
}
